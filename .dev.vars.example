# Copy to .dev.vars for local testing (`npm run preview`). .dev.vars is git-ignored — never commit it.
# In production, set these in Cloudflare Pages → Settings → Variables and Secrets (as encrypted secrets).

ADMIN_USERNAME=admin
# npm run hash-password
ADMIN_PASSWORD_HASH=
# npm run gen-secret
SESSION_SECRET=

# Local preview without GitHub: reads bundled content, validates saves, but commits nothing.
DEV_MODE=true

# Only needed to test real saving locally:
# GITHUB_TOKEN=
# GITHUB_REPO=mahendraaravind13-creator/portfolio
# GITHUB_BRANCH=main
